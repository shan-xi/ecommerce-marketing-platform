# Local development only. Never use these values in shared or production environments.
POSTGRES_DB=marketing_platform
POSTGRES_USER=marketing_app
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_PORT=5432
SERVER_PORT=8080

# Backend datasource settings. These defaults match the local Compose PostgreSQL service.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/marketing_platform
SPRING_DATASOURCE_USERNAME=marketing_app
SPRING_DATASOURCE_PASSWORD=local_dev_only_change_me
DB_POOL_SIZE=10
DB_MIN_IDLE=2

# Local-only JWT signing key (32 bytes, Base64). Replace before using any shared environment.
JWT_SECRET_BASE64=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
JWT_ISSUER=ecommerce-marketing-platform
JWT_AUDIENCE=ecommerce-marketing-platform-web
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P7D
FRONTEND_ORIGIN=http://localhost:5173
SPRING_PROFILES_ACTIVE=local

# Optional: set a private local password to initialize the four fictional @example.test users.
# Leave empty to keep the V2 seed hashes unchanged. Never commit your .env file.
DEMO_SEED_PASSWORD=
