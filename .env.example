# Local development only. Never use these values in shared or production environments.
POSTGRES_DB=marketing_platform
POSTGRES_USER=marketing_app
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_PORT=5432
SERVER_PORT=8080

# Backend datasource settings. These defaults match the local Compose PostgreSQL service.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/marketing_platform
SPRING_DATASOURCE_USERNAME=marketing_app
SPRING_DATASOURCE_PASSWORD=local_dev_only_change_me
DB_POOL_SIZE=10
DB_MIN_IDLE=2
